# Combined NetBird Server Configuration (Simplified)
# Generated by getting-started.sh

server:
  listenAddress: ":80"
  exposedAddress: "https://net.biseo.kr:443"
  stunPorts:
    - 3478
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "info"
  logFile: "console"

  authSecret: "__CHANGE_ME__"
  dataDir: "/var/lib/netbird"

  auth:
    issuer: "https://net.biseo.kr/oauth2"
    signKeyRefreshEnabled: true
    sessionCookieEncryptionKey: "__CHANGE_ME__"
    dashboardRedirectURIs:
      - "https://net.biseo.kr/nb-auth"
      - "https://net.biseo.kr/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"

  reverseProxy:
    trustedHTTPProxies:
      - "172.30.0.10/32"

  store:
    engine: "sqlite"
    encryptionKey: "__CHANGE_ME__"
